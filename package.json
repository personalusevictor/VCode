{
  "name": "vcode",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests scripts index.html vite.config.js package.json README.md",
    "format:check": "prettier --check src tests scripts index.html vite.config.js package.json README.md",
    "prebuild": "node scripts/build-search-index.mjs",
    "pretest": "node scripts/build-search-index.mjs",
    "index:build": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.2.2"
  }
}
